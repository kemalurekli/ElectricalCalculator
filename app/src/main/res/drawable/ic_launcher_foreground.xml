<?xml version="1.0" encoding="utf-8"?>
<!--
  The bolt, sized to the adaptive icon's safe zone.
  
  An adaptive layer is 108dp but only the central 72dp is guaranteed to survive
  the launcher's mask, so the mark is drawn 43dp tall and centred on (54,54) —
  every vertex sits inside the 66dp keyline circle. The same drawable is the
  monochrome layer, which the launcher tints itself; that is why it is a single
  flat path and not a fill with its own colour scheme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#CFE3F7"
        android:pathData="M59.64,32.40L40.85,55.88L52.12,55.88L48.36,75.60L67.15,51.18L55.88,51.18Z" />
</vector>
