<?xml version="1.0" encoding="utf-8"?>
<!--
  Almost empty, and correctly so.

  Every screen's text moved into its own feature module's `composeResources`
  when the app was split for iOS, because the shared code is what renders it.
  What is left here is what only the Android platform reads: the launcher label
  in the manifest.

  Twenty-two strings outlived that move as orphans — no `R.string` reference
  anywhere in `:app`, and no way for one to appear, since the module has no
  screens. They were deleted when the app gained ten more languages rather than
  translated ten more times. `ManifestResourcesTest` is what stops the one that
  is still needed from going with them.
-->
<resources>

    <!-- Product name: a brand, so it stays identical in every language. -->
    <string name="app_name" translatable="false">VoltageBoard</string>

</resources>
